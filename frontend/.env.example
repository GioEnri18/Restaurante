# ==============================================================================
# Variables de entorno del Frontend (Vite + React) — POS Restaurante Guatemala
# Copia este archivo a `.env` en desarrollo local o configúralas en Vercel.
# ==============================================================================

# URL base de la API REST (OBLIGATORIA en producción; en desarrollo cae a http://localhost:4000/api/v1)
# Ejemplo en producción (Render): https://pos-restaurante-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_API_TIMEOUT_MS=15000

# Muestra botones de acceso rápido con credenciales de prueba en /login.
# MANTENER SIEMPRE EN false EN PRODUCCIÓN.
VITE_SHOW_DEMO_LOGIN=false

# Identidad y configuración regional (Guatemala)
VITE_APP_NAME="POS Restaurante Guatemala"
VITE_CURRENCY_SYMBOL=Q
VITE_CURRENCY_CODE=GTQ
VITE_LOCALE=es-GT
VITE_TIMEZONE=America/Guatemala
VITE_IVA_RATE=0.12

# Reglas operativas de UI
VITE_OZ_PER_LB=16
VITE_FACTURAS_PAGE_SIZE=10
VITE_DEFAULT_PAGE_SIZE=15
VITE_ADMIN_ROLE_CODE=ADMIN
VITE_AUTH_STORAGE_KEY=pos_restaurante_gt_session
VITE_CART_STORAGE_KEY=pos_cart_v1
VITE_AUTO_PRINT_ENABLED=true
VITE_ENABLE_TABLE_SERVICE=false
VITE_DEFAULT_SERVICE_TYPE=MOSTRADOR
VITE_SPECIAL_MENU_NOTICE_DAYS=5
