{
  "name": "pos-restaurante-guatemala",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema POS modular para restaurante en Guatemala (GTQ, IVA 12%, multi-sucursal)",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "backend:install": "npm --prefix backend install",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:check": "npm --prefix backend run check",
    "backend:migrate": "npm --prefix backend run db:migrate",
    "backend:seed": "npm --prefix backend run db:seed",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
