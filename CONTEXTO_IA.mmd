%% ============================================================================
%% CONTEXTO DE LA ARQUITECTURA — SISTEMA POS RESTAURANTE (GUATEMALA)
%% Actualizado: 2026-11-25
%% Repositorio destino: https://github.com/GioEnri18/Restaurante.git
%% ============================================================================
%%
%% 1. DECISIONES DE ARQUITECTURA Y NEGOCIO
%% - Negocio: Restaurante en Guatemala, moneda Quetzales (GTQ / Q), IVA 12%
%%   INCLUIDO en el precio del menú (fórmula legal: base = total / 1.12).
%% - Servicio actual: MOSTRADOR y PARA LLEVAR por defecto; MESAS controlado por
%%   ENABLE_TABLE_SERVICE / VITE_ENABLE_TABLE_SERVICE=false; SERVICIO A DOMICILIO
%%   integral controlado por ENABLE_DELIVERY / VITE_ENABLE_DELIVERY=false
%%   (datos_delivery_json se conserva como legado sin uso en el flujo nuevo).
%% - Base de datos: PostgreSQL 16 (Docker Compose) + Sequelize 6 (CommonJS)
%%   con migraciones SQL versionadas en backend/src/database/migrations/ y
%%   rol de mínimo privilegio pos_app_rol.
%% - Multi-sucursal: aislamiento estricto por sucursal_id en entidades clave.
%% - Facturas como comprobante interno (sin certificación ante la SAT).
%% - Seguridad: JWT en cookie httpOnly (SameSite=Lax, Secure en prod) +
%%   protección CSRF (X-Requested-With + Origin) + bloqueo temporal por intentos
%%   fallidos + revocación por token_version + permisos cacheados con invalidación.
%% - Conversión de unidades centralizada: UnitConversionService (1 lb = 16 oz).
%% - Transacción atómica de venta: valida caja abierta -> venta -> factura ->
%%   comanda -> movimiento de caja -> descuento de inventario por receta ->
%%   auditoría inmutable en una sola transacción Sequelize.
%% - Auditoría de investigación (APPEND-ONLY):
%%   * Triggers bloquean UPDATE/DELETE/TRUNCATE; pos_app_rol solo SELECT/INSERT.
%%   * Columnas de contexto: actor_rol_codigo, aprobador_id, caja_sesion_id,
%%     severidad (BAJA/MEDIA/ALTA), codigo_motivo, impacto_financiero,
%%     correlacion_id (UUID). Sin backfill (filas previas derivan severidad).
%%   * Reglas centralizadas en auditoriaSeveridad.js + umbrales AUDIT_* en env.js.
%%   * Filtros unificados en auditoriaFiltros.js (listar, resumen SQL, exportar CSV).
%%   * Sanitización/redacción centralizada ([REDACTADO]) en AuditService.
%%   * Aislamiento estricto de nómina (GESTION_NOMINA solo ADMIN).
%%
%% 2. ARQUITECTURA DE CARPETAS
%% - Backend (backend/src/): MVC + Servicio por 10 dominios (JavaScript CommonJS)
%%   (auth, ventas, facturas, inventario, mermas, caja, reportes, auditoria,
%%   accesos, domicilios) + servicios compartidos (audit.service.js, auditoriaSeveridad.js,
%%   auditoriaFiltros.js, privacidadDomicilio.js, unitConversion.service.js, dates.js, tax.js).
%% - Frontend (frontend/src/): React 19 + TypeScript estricto + Tailwind + Zustand
%%   * config/env.ts       -> Variables VITE_* tipadas (incluye VITE_ENABLE_DELIVERY)
%%   * models/index.ts     -> Modelos de dominio estrictos (sin any)
%%   * adapters/           -> Traducción exclusiva JSON API <-> modelos UI
%%   * services/           -> Cliente HTTP (cookie httpOnly) y servicios por dominio
%%   * store/              -> Estado global Zustand (auth.store.ts, cart.store.ts sin PII)
%%   * ui/components/      -> common/, layout/, print/ (80mm + ticket entrega), ventas/,
%%                            domicilios/ (LiquidarPedidoModal, ZonasEntregaPanel),
%%                            caja/, inventario/, auditoria/
%%   * ui/pages/           -> 11 vistas protegidas por RBAC (incluye DomiciliosPage lazy)
%%
%% 3. ROLES Y PERMISOS CONFIGURABLES (RBAC EN BD)
%% - ADMIN      -> Control total + Accesos + Menús Especiales + Nómina + Domicilios (8 permisos)
%% - AUDITOR    -> Supervisión de caja + Auditoría económica + solo lectura reportes/domicilios
%% - CAJERO     -> Ventas + Caja (control dual) + Mermas + Domicilios (crear/asignar/liquidar/cancelar)
%% - MESERO     -> Ventas + Facturas (solo lectura)
%% - CHEF       -> Cocina/Mermas + Domicilios (ver, EN_PREPARACION, LISTO)
%% - REPARTIDOR -> Vista móvil "Mis entregas" (domicilios:ver_propios + EN_RUTA/ENTREGADO/FALLIDO)
%% ============================================================================

flowchart TD
