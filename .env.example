# Variables requeridas por docker-compose.yml (copiar a .env y definir valores seguros)
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=cambia-esta-contrasena-en-env
POSTGRES_DB=pos_restaurante_gt
POSTGRES_PORT=5432
DEFAULT_TIMEZONE=America/Guatemala

# Variables adicionales para el perfil completo: docker compose --profile full up -d --build
BACKEND_PORT=4000
FRONTEND_PORT=8080
CORS_ORIGIN=http://localhost:8080
# En producción DEBE tener al menos 32 caracteres aleatorios (sin palabras de ejemplo)
JWT_SECRET=reemplaza-con-una-clave-aleatoria-de-32-o-mas-caracteres
AUTH_COOKIE_SECURE=false
