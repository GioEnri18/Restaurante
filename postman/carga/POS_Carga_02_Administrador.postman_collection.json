{
  "info": {
    "name": "Administrador",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Ingredientes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET Ingredientes: HTTP 200', () => pm.expect([200]).to.include(pm.response.code));",
              "const lista = pm.response.json().data;",
              "const i = lista[Math.floor(Math.random() * lista.length)];",
              "pm.variables.set('ingredienteId', i.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "url": "{{baseUrl}}/inventario/ingredientes"
      }
    },
