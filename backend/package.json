{
  "name": "pos-restaurante-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST /api/v1 MVC con Node.js (JavaScript), Express y Sequelize para POS de Restaurante (Guatemala)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node src/database/checkSyntax.js",
    "typecheck": "node src/database/checkSyntax.js",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:bootstrap-prod": "node src/database/bootstrapProd.js",
    "db:cargar-menu-base": "node src/database/cargar-menu-base.js",
    "db:demo-bx": "node src/database/demo-bx.js",
    "test:unit": "node --test tests/unit.business.test.js tests/unit.auditoria.test.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "db:crear-rol-app": "node src/database/crearRolApp.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.10.1"
  }
}
