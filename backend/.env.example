# Configuración del servidor
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=2mb

# Seguridad y Rate Limiting
JWT_SECRET="cambia-esta-clave-secreta-super-segura-en-produccion-32-chars"
JWT_EXPIRES_IN="12h"
BCRYPT_SALT_ROUNDS=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=60
ADMIN_ROLE_CODE=ADMIN

# Base de datos PostgreSQL
DATABASE_URL="postgresql://pos_admin:pos_secret_2026@localhost:5432/pos_restaurante_gt?schema=public"

# Parámetros fiscales, unidades y paginación (Guatemala)
IVA_RATE=0.12
CURRENCY_CODE=GTQ
CURRENCY_SYMBOL=Q
DEFAULT_TIMEZONE=America/Guatemala
UNIT_OZ_PER_LB=16
FACTURAS_PAGE_SIZE=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Configuración operativa de servicio y menús especiales
ENABLE_TABLE_SERVICE=false
DEFAULT_SERVICE_TYPE=MOSTRADOR
SPECIAL_MENU_DEFAULT_NOTICE_DAYS=5

# Configuración futura FEL (SAT Guatemala)
FEL_ENABLED=false
FEL_PROVIDER=NONE
