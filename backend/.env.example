# Configuración del servidor
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
# Configurar a "1" o subred solo detrás de un proxy inverso confiable (Nginx/Cloudflare/ALB)
TRUST_PROXY=false
JSON_BODY_LIMIT=2mb
REQUEST_TIMEOUT_MS=15000

# Seguridad, Cookies httpOnly, CSRF y Rate Limiting (solo POST /auth/login)
# En producción DEBE ser una clave aleatoria de al menos 32 caracteres (sin palabras de ejemplo)
JWT_SECRET="cambia-esta-clave-secreta-super-segura-en-produccion-32-chars"
JWT_EXPIRES_IN="12h"
BCRYPT_SALT_ROUNDS=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
ADMIN_ROLE_CODE=ADMIN
AUTH_COOKIE_NAME=pos_session
AUTH_COOKIE_SAMESITE=lax
# En producción se fuerza Secure=true automáticamente (requiere HTTPS)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=43200000
CSRF_PROTECTION_ENABLED=true

# Seed de datos de prueba (en producción se bloquea salvo ALLOW_SEED_IN_PRODUCTION=true)
ALLOW_SEED_IN_PRODUCTION=false
SEED_ADMIN_PASSWORD=
SEED_CAJERO_PASSWORD=
SEED_MESERO_PASSWORD=

# Base de datos PostgreSQL + Pool y Timeouts anti-cola (Sequelize)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/pos_restaurante_gt"
# Base de datos separada usada automáticamente cuando NODE_ENV=test
DATABASE_URL_TEST="postgresql://USUARIO:CONTRASENA@localhost:5432/pos_restaurante_test"
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_POOL_ACQUIRE_MS=8000
DB_POOL_IDLE_MS=10000
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000

# Parámetros fiscales, unidades y paginación (Guatemala)
IVA_RATE=0.12
CURRENCY_CODE=GTQ
CURRENCY_SYMBOL=Q
DEFAULT_TIMEZONE=America/Guatemala
UNIT_OZ_PER_LB=16
FACTURAS_PAGE_SIZE=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Configuración operativa de servicio y menús especiales
ENABLE_TABLE_SERVICE=false
DEFAULT_SERVICE_TYPE=MOSTRADOR
SPECIAL_MENU_DEFAULT_NOTICE_DAYS=5
DELIVERY_JSON_MAX_KEYS=20
DELIVERY_JSON_MAX_DEPTH=2
DELIVERY_JSON_MAX_BYTES=2048

# Configuración FEL (SAT Guatemala — se certifica y anula SIEMPRE post-commit fuera de la transacción)
# Valores FEL_PROVIDER: NONE (desactivado), SIMULADOR (pruebas locales), o proveedor SAT configurado
FEL_ENABLED=false
FEL_PROVIDER=NONE
