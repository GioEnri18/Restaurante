# ==============================================================================
# Variables de entorno del Backend (Node.js + Express + Sequelize + PostgreSQL)
# Copia este archivo a `backend/.env` en desarrollo local. Nunca subas `.env`.
# ==============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=2mb
REQUEST_TIMEOUT_MS=15000
LOG_LEVEL=info

# Base de datos PostgreSQL (desarrollo y pruebas separadas)
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/pos_restaurante_gt
DATABASE_URL_TEST=postgresql://pos_user:pos_password@localhost:5432/pos_restaurante_test
# Opcional: conexión con privilegios de dueño solo para ejecutar migraciones
# DATABASE_MIGRATION_URL=
# DATABASE_MIGRATION_URL_TEST=
MIGRATE_ON_START=false
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_POOL_ACQUIRE_MS=8000
DB_POOL_IDLE_MS=10000
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL=auto
DB_SSL_REJECT_UNAUTHORIZED=false

# Seguridad, JWT, cookies httpOnly y bloqueo por intentos fallidos
# En NODE_ENV=production exige >= 32 caracteres aleatorios sin palabras de ejemplo
JWT_SECRET=cambia-esta-clave-local-por-32-caracteres-aleatorios
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
PERMISOS_CACHE_TTL_MS=30000
ADMIN_ROLE_CODE=ADMIN
AUTH_COOKIE_NAME=pos_session
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=43200000
CSRF_PROTECTION_ENABLED=true

# Seed de desarrollo (mantener siempre en false en producción)
ALLOW_SEED_IN_PRODUCTION=false
# SEED_ADMIN_PASSWORD=
# SEED_CAJERO_PASSWORD=
# SEED_MESERO_PASSWORD=
# SEED_REPARTIDOR_PASSWORD=

# Configuración fiscal y operativa (Guatemala)
IVA_RATE=0.12
CURRENCY_CODE=GTQ
CURRENCY_SYMBOL=Q
DEFAULT_TIMEZONE=America/Guatemala
UNIT_OZ_PER_LB=16
FACTURAS_PAGE_SIZE=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ENABLE_TABLE_SERVICE=false
# Módulo de Servicio a Domicilio (feature flag, bloqueo de cierre con pendientes y rate limit de búsqueda)
ENABLE_DELIVERY=false
DELIVERY_BLOQUEAR_CIERRE_CON_PENDIENTES=true
DELIVERY_CLIENTE_BUSQUEDA_WINDOW_MS=60000
DELIVERY_CLIENTE_BUSQUEDA_MAX=30
DELIVERY_CLIENTE_BUSQUEDA_LIMIT=5
DELIVERY_TRACKING_TTL_HORAS=24
DEFAULT_SERVICE_TYPE=MOSTRADOR
SPECIAL_MENU_DEFAULT_NOTICE_DAYS=5
VENTA_MAX_LINEAS=50
VENTA_MAX_CANTIDAD_POR_LINEA=100
DELIVERY_JSON_MAX_KEYS=20
DELIVERY_JSON_MAX_DEPTH=2
DELIVERY_JSON_MAX_BYTES=2048

# Umbrales y límites del módulo de Auditoría de investigación
# Monto en Quetzales a partir del cual egresos/mermas/ajustes/compras escalan a severidad ALTA
AUDIT_IMPACTO_ALTO_Q=500
# Diferencia de arqueo de caja (|contado - esperado|) en Quetzales que escala a severidad ALTA
AUDIT_DIFERENCIA_CAJA_ALTA_Q=50
# Cantidad de ocurrencias repetitivas en un mismo turno (o aprobador recurrente) que dispara alerta/ALTA
AUDIT_REPETICION_UMBRAL=3
# Límite máximo de filas permitidas por exportación CSV en GET /api/v1/auditoria/exportar
AUDIT_EXPORT_MAX_ROWS=10000
